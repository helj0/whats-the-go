# Copy this to .env for local dev. On Railway, set these as project Variables instead.

# From the Discord Developer Portal, your Application's Bot tab.
DISCORD_TOKEN=

# From the Discord Developer Portal, your Application's General Information tab (Application ID).
DISCORD_CLIENT_ID=

# Set automatically if you add the Postgres plugin in Railway.
# For local dev, point this at a local Postgres instance, e.g.:
# postgres://postgres:password@localhost:5432/pogo_buddy
DATABASE_URL=
